  {
   "id": "g-hdr10-hevc",
   "category": "hdr",
   "kind": "generate",
   "file": "hdr/g-hdr10-hevc.mkv",
   "cmd": [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-i",
    "{master}",
    "-t",
    "20",
    "-vf",
    "scale=1920:1080,format=yuv420p10le",
    "-c:v",
    "libx265",
    "-preset",
    "fast",
    "-x265-params",
    "hdr10=1:repeat-headers=1:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc:master-display=G(13250,34500)B(7500,3000)R(34000,16000)WP(15635,16450)L(10000000,1):max-cll=1000,400",
    "-color_primaries",
    "bt2020",
    "-color_trc",
    "smpte2084",
    "-colorspace",
    "bt2020nc",
    "-c:a",
    "copy",
    "{out}"
   ],
   "license": "derived from Sintel (CC BY 3.0, Blender Foundation)",
   "notes": "HEVC Main10 PQ with mastering-display + CLL SEI (SDR source tagged PQ: picture is wrong-looking, signalling is right)"
  },
